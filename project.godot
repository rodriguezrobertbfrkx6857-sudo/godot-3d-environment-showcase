; Godot project configuration - 3D Environment Showcase
; Generated as a self-contained, procedural portfolio project.
config_version=5

[application]

config/name="Godot 3D Environment Showcase"
run/main_scene="res://scenes/showcase_main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.025, 0.035, 0.07, 1)

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.025, 0.035, 0.07, 1)

